@import url("/tema.css");


* {
    margin: 0;
    box-sizing: border-box;
}

body {
    margin: 0;
    background-color: var(--corFundoBarraCabecalho);
    color: var(--corTextoDestrutivo);
    font-family: 'Geist', sans-serif;
    line-height: 1.3;
    #background: #111827 !important;
}

main {
    padding: 45px;
}

nav {
    width: 100%;
    height: 7vh;
    background-color: var(--corFundoBarraCabecalho);
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 15px;
    border-bottom: 1px solid var(--corDestaque);
}

nav h2 {
    color: #F8F8F8;
}
.logo {
    flex: 1;
}

.logo h1{
    font-size: 20px;
    color: var(--corDestaque);

}

.logo h3{
    font-size: 12px;
    color: var(--corTextoDestrutivo);
    font-weight: 500;
}

.botoes {
    flex: 6;
    display: flex;
    justify-content: center;
}

.botoes button{
    color: var(--corFundoBarraCabecalho);
    background-color: var(--corDestaque);
    border: none;
    outline: none;
    font-size: 18px;
    font-weight: lighter;
    margin: 0 15px;
    padding: 6px 18px;
    border-radius: 4px;
}


.pesquisa {
    flex: 2;
}


.inputPesquisa {
    display: flex;
    height: 4.5vh;
}

.inputPesquisa input {
    display: flex;
    align-items: center;
    padding-left: 15px;
    width: 100%;
    border: 0;
    background-color: var(--corFundoBarraCabecalho);
    border-radius: 8px;
    font-size: 16px;
    flex: 9;
    outline: none;
    height: 100%;
    border: 1px solid var(--corDestaque);
    color: var(--corTextoDestrutivo);
}





.seletorPacotes {
    display: flex;
    justify-content: left;

    align-items: center;

    margin-bottom: 35px;
}

.seletorPacotes div:has(input[type="radio"]:checked) {
    background-color: var(--corFundoSucesso);
    transition: 0.3s;
    label {
        color: var(--corTextoDestrutivo);
    }
}

.seletorPacotes div {
    position: relative;
    width: 100px;
    margin-right: 15px;
    display: flex;
    justify-content: center;
    align-items: center;
    background-color: var(--corDestaque);
    padding: 5px 22px;
    border-radius: 15px;
    transition: 0.3s;
}

.seletorPacotes div label {
    font-size: 20px;
    color: var(--corFundoBarraCabecalho);
}

.seletorPacotes div input {
    position: absolute;
    width: 100%;
    height: 100%;
    opacity: 0;
}






.resultados {
    margin-top: 35px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
    gap: 20px 25px;
    width: 100%;
}

#buscar {
    height: 100%;
    flex: 1;
    display: block;
    background-color: #DFC366;
    outline: none;
    border: none;

    border-bottom-right-radius: 12px;
    border-top-right-radius: 12px;

    border-bottom: 2px solid var(--outline);
    border-top: 2px solid var(--outline);
    border-right: 2px solid var(--outline);
}

.package-card {
    margin-top: 12px;
    padding: 18px;
    border: 1px solid #273244;
    border-radius: 12px;
    background: #182235;
}

.package-card h2 {
    margin-top: 0;
}




.resultado  {
    height: 250px;
    padding: 18px;
    border: 1px solid var(--corBordaBarraLateral);
    border-radius: 12px;
    background: var(--corFundoPopUp);
    display: flex;
    justify-content: space-between;
}


.resultado h2 {
    color: #DFC366;
}

.resultado button {
    background-color: #DFC366;
    height: 3vh;
    flex: 1;
    display: block;
    outline: none;
    border: none;
    padding: 0 14px;
    border-radius: 5px;
}

.resultado p {
    color: #F8F8F8;
}

.resultado small {
    color: #F8F8F8;
}

.resultado section {
    display: flex;
    align-items: flex-end;
}